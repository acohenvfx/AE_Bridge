{
  "name": "ae-bridge",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-03",
  "workers_dev": false,
  "assets": {
    "directory": "./dist/html",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
